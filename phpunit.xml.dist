<!-- Copy to phpunit.xml and customize as needed. -->
<phpunit backupGlobals="false"
    bootstrap="tests/bootstrap.inc"
    colors="true">
  <testsuites>
    <!--
      Default suite: runs both unit and integration tests.
      Requires UNISH_DB_URL and a working MySQL server.
    -->
    <testsuite name="all">
      <directory>tests</directory>
    </testsuite>
    <!--
      Unit suite: fast tests that bootstrap Drush but do not require a live
      Drupal site or database.
      Run with: ./vendor/bin/phpunit - -testsuite unit
    -->
    <testsuite name="unit">
      <directory>tests/Unish</directory>
      <file>tests/backendUnitTest.php</file>
      <file>tests/commandUnitTest.php</file>
      <file>tests/expandWildcardTablesUnitTest.php</file>
      <file>tests/outputFormatUnitTest.php</file>
      <file>tests/pmRequestUnitTest.php</file>
      <file>tests/releaseInfoTest.php</file>
      <file>tests/siteAliasUnitTest.php</file>
      <file>tests/siteSetUnitTest.php</file>
      <file>tests/tablesUnitTest.php</file>
      <file>tests/xhUnitTest.php</file>
    </testsuite>
  </testsuites>

  <php>
    <!-- These variables may alternatively be set as environment variables. -->

    <!-- Drupal major version to run tests over -->
    <!-- <var name="UNISH_DRUPAL_MAJOR_VERSION" value="7"/> -->

    <!--Uncomment and edit one of the lines below depending on DB platform.-->
    <!--DB User must have create/drop permissions-->
    <!-- <var name="UNISH_DB_URL" value="mysql://root:@127.0.0.1"/> -->
    <!-- <var name="UNISH_DB_URL" value="pgsql://postgres:@localhost"/>-->
    <!-- <var name="UNISH_DB_URL" value="sqlite://none/of/this/matters"/> -->

    <!--User must have write permissions to this directory.-->
    <!--If not supplied, defaults to sys_get_temp_dir().-->
    <!-- <var name="UNISH_TMP" value="/tmp"/> -->

    <!--Uncomment the line below if your path to drush differs from `which drush`. Use absolute path.-->
    <!--<var name="UNISH_DRUSH" value="/path/to/drush"/>-->

    <!--Uncomment to provide a group the user running the tests belong to. This is needed for some filesystem tests. -->
    <!--<var name="UNISH_USERGROUP" value="staff"/>-->

    <!-- Uncomment to disable the total runtime and output timeouts for commands run through CommandUnishTestCase::execute(). -->
    <!-- <env name="UNISH_NO_TIMEOUTS" value="y"/> -->
  </php>
</phpunit>
