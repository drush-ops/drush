<?xml version="1.0"?>
<!--

      Configuration for the unit suite. The kernel suite uses
      phpunit.kernel.xml.dist. Copy and rename this file to phpunit.xml to
      customize.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" colors="true" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd">
  <coverage/>
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">unit</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled=1"/>
    <includePath>.</includePath>
  </php>
</phpunit>
