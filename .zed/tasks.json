[
  {
    "label": "Worktree setup: ddev config",
    "command": "sh",
    "args": [
      "-c",
      "echo \"name: drush-$(basename $(dirname $PWD))\" > .ddev/config.local.yaml",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",
  },
  {
    "label": "Worktree setup: composer install",
    "command": "composer",
    "args": ["install"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",
  },
]
